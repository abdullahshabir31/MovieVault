# Copy this file to .env and fill in your own values.
# See SUPABASE_SETUP.md for where to find each of these.
# Never commit the real .env file.

# --- Supabase (client-safe, exposed to the browser via Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only, read via process.env in *.server.js and route middleware) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key bypasses Row Level Security. Server-side only — never
# prefix this with VITE_ or it will be bundled into client-side JavaScript.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (server-only; used by src/lib/tmdb.functions.js) ---
# Accepts either a classic v3 API key or a v4 Read Access Token (starts with "ey...").
TMDB_API_KEY=

# --- Web push (client-safe public key; generate with `npx web-push generate-vapid-keys`) ---
VITE_VAPID_PUBLIC_KEY=
# Private half stays server-only — set as a Supabase Edge Function secret,
# never here (see supabase/functions/check-new-releases).
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=
